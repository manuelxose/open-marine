{
  "name": "open-marine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "init": "node scripts/init-cross-platform.mjs",
    "migrate:raspberry": "node scripts/migrate-to-raspberry-cross-platform.mjs",
    "deploy:raspberry": "node scripts/migrate-to-raspberry-cross-platform.mjs",
    "start:signalk": "cd signalk-runtime && docker compose up -d",
    "stop:signalk": "cd signalk-runtime && docker compose down",
    "logs:signalk": "cd signalk-runtime && docker compose logs -f signalk",
    "start:simulator": "cd marine-data-simulator && npm run dev",
    "start:wind-demo": "node scripts/start-wind-demo.mjs",
    "start:ui": "cd marine-instrumentation-ui && npm run start:lan",
    "start:ui:local": "cd marine-instrumentation-ui && npm start",
    "start:ais": "node scripts/start-ais-cross-platform.mjs",
    "start:imu": "node scripts/start-imu-cross-platform.mjs",
    "start:gps": "node scripts/start-gps-cross-platform.mjs",
    "start:wind": "node scripts/start-wind-cross-platform.mjs",
    "start:autopilot": "node scripts/start-autopilot-cross-platform.mjs",
    "start:test-bench": "cd marine-test-bench && npm run dev",
    "build:contract": "cd marine-data-contract && npm run build",
    "build:gateway": "cd marine-sensor-gateway && npm run build",
    "build:simulator": "cd marine-data-simulator && npm run build",
    "build:ui": "cd marine-instrumentation-ui && npm run build",
    "build:autopilot": "cd marine-autopilot-engine && npm run build",
    "build:test-bench": "cd marine-test-bench && npm run build",
    "status": "node scripts/status.mjs"
  }
}
