{
  "name": "open-marine",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "marine-data-contract",
    "marine-sensor-gateway",
    "marine-simulation-platform",
    "marine-instrumentation-ui",
    "marine-autopilot-engine",
    "marine-chart-engine",
    "marine-tile-server"
  ],
  "scripts": {
    "init": "node scripts/init-cross-platform.mjs",
    "migrate:raspberry": "node scripts/migrate-to-raspberry-cross-platform.mjs",
    "deploy:raspberry": "node scripts/migrate-to-raspberry-cross-platform.mjs",
    "build": "npm run build --workspaces",
    "build:contract": "npm run build -w @omi/marine-data-contract",
    "build:gateway": "npm run build -w marine-sensor-gateway",
    "build:simulator": "npm run build:simulation",
    "build:simulation": "npm run build -w marine-simulation-platform",
    "build:ui": "npm run build -w marine-instrumentation-ui",
    "build:autopilot": "npm run build -w marine-autopilot-engine",
    "build:test-bench": "npm run build:simulation",
    "build:charts": "npm run build -w marine-chart-engine",
    "build:tile-server": "npm run build -w marine-tile-server",
    "test": "npm run test --workspaces",
    "test:contract": "npm run test:run -w @omi/marine-data-contract",
    "test:gateway": "npm test -w marine-sensor-gateway",
    "test:autopilot": "npm test -w marine-autopilot-engine",
    "test:test-bench": "npm run test:simulation",
    "test:simulation": "npm test -w marine-simulation-platform",
    "test:charts": "npm test -w marine-chart-engine",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "start:signalk": "cd signalk-runtime && docker compose up -d",
    "stop:signalk": "cd signalk-runtime && docker compose down",
    "logs:signalk": "cd signalk-runtime && docker compose logs -f signalk",
    "start:simulator": "npm run dev -w marine-simulation-platform -- live",
    "start:simulation": "npm run dev -w marine-simulation-platform -- live",
    "start:simulation-bench": "npm run dev -w marine-simulation-platform -- bench",
    "start:wind-demo": "node scripts/start-wind-demo.mjs",
    "start:ui": "npm run start:lan -w marine-instrumentation-ui",
    "start:ui:local": "npm start -w marine-instrumentation-ui",
    "start:ais": "node scripts/start-sensor-cross-platform.mjs ais",
    "start:imu": "node scripts/start-sensor-cross-platform.mjs imu",
    "start:gps": "node scripts/start-sensor-cross-platform.mjs gps",
    "start:wind": "node scripts/start-sensor-cross-platform.mjs wind",
    "start:autopilot": "node scripts/start-sensor-cross-platform.mjs autopilot",
    "start:test-bench": "npm run dev -w marine-simulation-platform -- bench",
    "start:charts": "npm run dev -w marine-chart-engine",
    "charts:import-mbtiles": "npm run import:mbtiles -w marine-chart-engine --",
    "charts:convert-raster": "npm run convert:raster -w marine-chart-engine --",
    "charts:convert-s57": "npm run convert:s57 -w marine-chart-engine --",
    "status": "node scripts/status.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.20.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@types/node": "^20.19.30"
  }
}
