[Unit]
Description=Open Marine autopilot engine (control loop, safety, motor driver)
After=network-online.target docker.service signalk.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/manu/open-marine
# The engine always boots in STANDBY with the motor disabled; it never drives
# the motor by default. Restart on failure only — a crash loop must not keep
# re-engaging the drive; the microcontroller heartbeat failsafe also cuts power.
ExecStart=/usr/bin/node /home/manu/open-marine/scripts/start-sensor-cross-platform.mjs autopilot
Restart=on-failure
RestartSec=5
User=manu
# Serial backend talks to the microcontroller over UART.
SupplementaryGroups=dialout
Environment=AP_MOTOR_BACKEND=serial
Environment=AP_SERIAL_PORT=/dev/ttyAMA0

[Install]
WantedBy=multi-user.target
