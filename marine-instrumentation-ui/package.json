{
  "name": "marine-instrumentation-ui",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build -w @omi/marine-data-contract",
    "start": "ng serve",
    "prestart:lan": "npm run build -w @omi/marine-data-contract",
    "start:lan": "ng serve --host 0.0.0.0 --port 4200 --allowed-hosts",
    "prebuild": "npm run build -w @omi/marine-data-contract",
    "build": "ng build",
    "prewatch": "npm run build -w @omi/marine-data-contract",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run build -w @omi/marine-data-contract",
    "test": "ng test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pretest:ci": "npm run build -w @omi/marine-data-contract",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "ci": "npm run lint && npm run test:ci && npm run build"
  },
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@omi/marine-data-contract": "*",
    "maplibre-gl": "^5.16.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uplot": "^1.6.32",
    "ws": "^8.21.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@angular-eslint/eslint-plugin-template": "^19.0.0",
    "@angular-eslint/template-parser": "^19.0.0",
    "@angular/build": "^21.2.17",
    "@angular/cli": "^21.2.17",
    "@angular/compiler-cli": "^21.2.17",
    "@angular/service-worker": "^21.2.17",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@typescript-eslint/utils": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9"
  }
}
