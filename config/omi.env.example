# OMI local configuration
# Copy this file to config/omi.env and edit values for your machine.

# AIS defaults (used by scripts/start-ais.* and init summaries)
AIS_PPM=-50
AIS_GAIN=33
AIS_HOST=127.0.0.1
AIS_PORT=10110
OMI_SIGNALK_IMAGE=signalk/signalk-server:v2.22.1

# Raspberry migration defaults
RPI_HOST=raspberrypi.local
RPI_USER=pi
RPI_PORT=22
RPI_PATH=/home/pi/open-marine

# Optional SSH settings
# RPI_SSH_KEY=C:/Users/your-user/.ssh/id_ed25519
# RPI_PASSWORD=your-password
# RPI_SSH_CLIENT=putty      # Windows: putty|openssh (putty enables non-interactive password)
# RPI_SSH_CLIENT=sshpass    # Linux: sshpass|openssh (sshpass enables non-interactive password)
# RPI_HOSTKEY=ssh-ed25519 255 SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
