# OMI local configuration
# Copy this file to config/omi.env and edit values for your machine.

# AIS defaults (used by scripts/start-ais.* and init summaries)
AIS_PPM=-50
AIS_GAIN=33
AIS_HOST=127.0.0.1
AIS_PORT=10110

# IMU defaults (used by scripts/start-imu.* and init summaries)
IMU_HOST=127.0.0.1
IMU_PORT=3000
IMU_RATE=10
IMU_AUTO_SETUP=true
IMU_RAW_ONLY=false
IMU_NO_PUBLISH=false

# GPS defaults (used by scripts/start-gps.* and init summaries)
GPS_DEVICE=auto
GPS_BAUD=9600
GPS_HOST=127.0.0.1
GPS_PORT=3000
GPS_RATE=1
GPS_AUTO_SETUP=true
GPS_STATIONARY_SOG_KNOTS=2.0
GPS_STATIONARY_RADIUS_METERS=12

# NMEA 0183 wind sensor defaults (MWV/MWD)
WIND_DEVICE=auto
WIND_BAUD=4800
WIND_HOST=127.0.0.1
WIND_PORT=3000
WIND_NO_PUBLISH=false

# Autopilot engine (marine-autopilot-engine) — see its docs/MOTOR_PROTOCOL.md
AP_MOTOR_BACKEND=sim          # sim | serial | gpio | can  (sim = test bench)
AP_SENSOR_BACKEND=sim         # sim | signalk (use signalk with real GPS/IMU and a safe simulated motor)
AP_SERIAL_PORT=/dev/ttyAMA0   # serial backend → microcontroller (UART)
AP_SERIAL_BAUD=115200
AP_SK_WS_URL=ws://127.0.0.1:3000/signalk/v1/stream
AP_SK_HTTP_URL=http://127.0.0.1:3000
AP_API_PORT=3990              # command API the UI talks to
AP_LOOP_HZ=10
AP_WATCHDOG_TIMEOUT_MS=1000
# PID + limits (degrees / amps / volts)
AP_PID_KP=1.2
AP_PID_KI=0.05
AP_PID_KD=8
AP_DEADBAND_DEG=1
AP_RUDDER_LIMIT_DEG=35
AP_PWM_MIN=0.15          # min drive fraction (0..1) to overcome friction
AP_PWM_MAX=1.0          # max drive fraction (0..1)
AP_CURRENT_LIMIT_A=10
AP_VOLTAGE_CUTOFF=11.5
AP_TACK_ANGLE_DEG=40    # TRACK no-go half-angle: min sailable apparent wind angle
AP_ARRIVAL_RADIUS_M=30  # TRACK: within this of the active waypoint, advance the route
# Bench-only true wind + start position (AP_SENSOR_BACKEND=sim)
AP_SIM_TWD_DEG=45
AP_SIM_TWS_KT=12
AP_SIM_START_LAT=43.46
AP_SIM_START_LON=-3.8
AP_SIM_CRUISE_KT=5
# Bench-only TRACK waypoint as bearing+distance from start (0 distance = no waypoint)
AP_SIM_WP_BRG_DEG=0
AP_SIM_WP_DIST_NM=0
# Bench-only TRACK route as relative legs "brg:distNm,brg:distNm,…" (overrides single waypoint; auto-advances)
AP_SIM_ROUTE=

# Chart engine (marine-chart-engine) — optional, requires GDAL/tippecanoe for conversions
CHART_ENGINE_PORT=8088
CHART_ENGINE_DATA_DIR=/var/lib/open-marine
CHART_ENGINE_CACHE_DIR=/var/lib/open-marine/chart-cache
CHART_ENGINE_UPLOAD_DIR=/var/lib/open-marine/chart-uploads
CHART_ENGINE_UPLOAD_MAX_MB=2048

OMI_SIGNALK_IMAGE=signalk/signalk-server:v2.22.1

# Raspberry migration defaults
RPI_HOST=raspberrypi.local
RPI_USER=pi
RPI_PORT=22
RPI_PATH=/home/pi/open-marine

# Optional SSH settings
# RPI_SSH_KEY=C:/Users/your-user/.ssh/id_ed25519
# RPI_PASSWORD=your-password
# RPI_SSH_CLIENT=putty      # Windows: putty|openssh (putty enables non-interactive password)
# RPI_SSH_CLIENT=sshpass    # Linux: sshpass|openssh (sshpass enables non-interactive password)
# RPI_HOSTKEY=ssh-ed25519 255 SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Isolated professional test bench. These ports must never overlap production.
BENCH_API_PORT=4100
BENCH_SIGNALK_PORT=3100
BENCH_AUTOPILOT_PORT=3991
BENCH_DB_PATH=./data/test-bench.sqlite
BENCH_RETENTION_DAYS=90
BENCH_RETENTION_MAX_BYTES=1073741824
