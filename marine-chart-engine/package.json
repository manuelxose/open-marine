{
  "name": "marine-chart-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "convert:raster": "npm run build && node dist/cli/convert-raster.js",
    "convert:s57": "npm run build && node dist/cli/convert-s57.js",
    "dev": "npm run build && node --watch dist/server.js",
    "import:mbtiles": "npm run build && node dist/cli/import-mbtiles.js",
    "sync:copernicus": "python scripts/sync-copernicus-vigo.py",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "fast-xml-parser": "^4.5.6",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.10",
    "typescript": "^5.9.3"
  }
}
