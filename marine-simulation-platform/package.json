{
  "name": "marine-simulation-platform",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./publishers/*": {
      "types": "./dist/publishers/*.d.ts",
      "default": "./dist/publishers/*.js"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "default": "./dist/runtime/*.js"
    },
    "./api/*": {
      "types": "./dist/api/*.d.ts",
      "default": "./dist/api/*.js"
    },
    "./persistence/*": {
      "types": "./dist/persistence/*.d.ts",
      "default": "./dist/persistence/*.js"
    },
    "./scenarios/*": {
      "types": "./dist/scenarios/*.d.ts",
      "default": "./dist/scenarios/*.js"
    }
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "dev:bench": "tsx src/cli/index.ts bench",
    "dev:live": "tsx src/cli/index.ts live --scenario wind-gps-demo",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@omi/marine-data-contract": "*",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.30"
  }
}
